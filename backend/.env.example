GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_JS_API_KEY=your_google_maps_api_key_here

# Local synthetic-data demo only. For a hosted showcase set mode=operator and
# generate a high-entropy token (e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))').
# Unlock in the browser; never put this token in frontend build variables.
RAPIDGRID_MODE=demo
RAPIDGRID_OPERATOR_TOKEN=
# Empty uses backend/data. Set an absolute persistent path on hosted services.
RAPIDGRID_DATA_DIR=
# Optional, comma-separated development origins. Same-origin needs no entry.
RAPIDGRID_ALLOWED_ORIGINS=
# Header carrying the client address behind a proxy, used to throttle wrong
# access tokens per client. Defaults to x-forwarded-for on Render, else the
# socket address.
# RAPIDGRID_CLIENT_IP_HEADER=true-client-ip
# Demo mode answers API calls only for local host names (DNS-rebinding
# protection). Add others, comma-separated, e.g. a LAN name for a shared demo.
# RAPIDGRID_ALLOWED_HOSTS=demo.lan
# Contacts directory: unit crews, hospital ER/ICU numbers, dispatch, 112, and
# 6-digit staff PINs. Never commit real values. Either put the JSON itself in
# RAPIDGRID_CONTACTS (a hosting secret) or point RAPIDGRID_CONTACTS_FILE at a
# file; backend/contacts.json is git-ignored. Format: contacts.example.json.
# Any staff PIN switches staff sign-in on.
# RAPIDGRID_CONTACTS=
# RAPIDGRID_CONTACTS_FILE=
# Signs staff sessions and keys PIN checks. Long and random, e.g.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# RAPIDGRID_SECRET=
